PORT=3000

# chave que protege as rotas /api - use a mesma no header x-api-key do front e do n8n
API_KEY=troque-por-uma-chave-forte-aqui

# opcional: URL do seu webhook n8n para receber alertas automaticos
# disparado quando uma missao urgente e criada, ou muda para "travado"
ALERT_WEBHOOK_URL=https://webhook.servidorwall.online/webhook/teia-alertas
